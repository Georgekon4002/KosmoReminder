# ============================================================================
# KosmoSMS — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values.
# .env is in .gitignore — never commit secrets!
# ============================================================================

# --- Database ----------------------------------------------------------------
# ODBC connection string to YOUR KosmoSMS database (not the Slis database).
# Example for Windows Authentication:
#   DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=KosmoSMS;Trusted_Connection=yes;
# Example for SQL Authentication:
#   DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=KosmoSMS;UID=myuser;PWD=mypassword;
DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=KosmoSMS;Trusted_Connection=yes;

# --- easysms.gr API ----------------------------------------------------------
EASYSMS_API_KEY=your_api_key_here
EASYSMS_BASE_URL=https://easysms.gr/api

# Sender IDs (must be registered/approved with easysms.gr)
VIBER_SENDER_ID=Kosmoiatriki
SMS_SENDER_ID=Kosmoiatriki

# The public URL that easysms.gr will call back with delivery reports.
# During development, use ngrok: e.g. https://abc123.ngrok.io/api/sms-callback
CALLBACK_URL=https://YOUR_DOMAIN/api/sms-callback

# --- Reminder Settings -------------------------------------------------------
# How many hours before the appointment to send the reminder (default: 24)
LEAD_TIME_HOURS=24

# How often (in minutes) the reminder service checks for due appointments (default: 15)
INTERVAL_MINUTES=15

# Message template placeholders: {Department}, {LabName}, {LabAddress}, {Day}, {Date}, {Time}
# Also available for custom variants: {Greeting}, {ExamType}
MESSAGE_TEMPLATE=ΚΟΣΜΟΙΑΤΡΙΚΗ: Σας υπενθυμίζουμε το ραντεβού σας στο {Department} της Μονάδας {LabName} ({LabAddress}) είναι προγραμματισμένο για την {Day} {Date} και ώρα {Time}.

# --- Callback Receiver (Flask) -----------------------------------------------
# Host and port for the Flask callback receiver
CALLBACK_HOST=0.0.0.0
CALLBACK_PORT=5000

# --- Email Settings ----------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ΚΟΣΜΟΪΑΤΡΙΚΗ
ORGANIZER_EMAIL=
EMAIL_CONFIRMATION_SUBJECT_TEMPLATE= Υπενθύμιση ραντεβού στην Κοσμοϊατρική - {Department}

# --- Resend Settings ---------------------------------------------------------
RESEND_API_KEY=
RESEND_TEMPLATE_ID=
